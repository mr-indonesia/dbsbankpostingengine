@using Apps.Core.DTOS
@model Apps.Core.DTOS.WorkflowDTO

<div id="content">
    <h1 class="page-title txt-color-blueDark">
        <i class="fa-fw fa fa-desktop"></i>
        Workflow Config
    </h1>

    <!--WIDGET GRID-->
    <section id="widget-grid">
        <!--User Mapping-->
        <div class="row">
            <article class="col-sm-12">
                <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-0" data-widget-togglebutton="false" data-widget-editbutton="false" data-widget-fullscreenbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false">
                    <!--HEADER WIDGET-->
                    <header>
                        <span class="widget-icon"><i class="fa fa-table txt-color-blueDark"></i></span>
                        <h2>Workflow > Setup</h2>
                    </header>
                    <!--END HEADER WIDGET-->
                    <!--WIDGET DIV-->
                    <div>
                        <!--Workflow Header-->
                        <div class="row">
                            <div class="form-horizontal">
                                <div class="col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label class="col-md-3 control-label italicbold">Workflow ID</label>
                                        <div class="col-md-8">
                                            <input type="text" id="HeaderId" name="HeaderId" value="@Model.HeaderID.ToString()" class="form-control" readonly />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-3 control-label italicbold">Workflow Name</label>
                                        <div class="col-md-8">
                                            <input type="text" id="WfName" name="WfName" value="@Model.Name.ToString()" class="form-control" readonly />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-3 control-label italicbold">Category Type</label>
                                        <div class="col-md-8">
                                            @Html.DropDownListFor(s => s.CategoryTypeID, ViewBag.ProductGroups as SelectList, new { @class = "form-control selectpicker", @data_live_search = "true", @Disabled = "disable" })
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-md-3 control-label italicbold">Status</label>
                                        <div class="col-md-8" style="margin-top: 5px;">
                                            <input type="checkbox" id="status" name="status" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <br />

                        <div style="text-align: center; padding: 10px; border: 1px solid grey; background-color: #d3d3d321; font-style: italic;">
                            <b>Approval Step Detail</b>
                        </div>
                        <br />

                        <div class="row">
                            <div class="col-md-8">

                            </div>
                            <div class="col-md-4" style="text-align: right;">
                                <p>
                                    <button type="button" class="btn btn-success">Activation</button>&nbsp;
                                    <button type="button" class="btn btn btn-primary">Save</button>&nbsp;
                                    <button type="button" class="btn btn-light" data-toggle="modal" data-target="#ModalAddWorkflowApproval" onclick="CreateNewModal();"><span class="glyphicon glyphicon-plus"></span></button>
                                </p>
                            </div>
                        </div>
                        <br />
                        <!--End Workflow Header-->
                        <!--EDIT BOX-->
                        <div class="jarviswidget-editbox">
                        </div>
                        <!--END EDIT BOX-->
                        <!--WIDGET BODY-->
                        <div class="widget-body no-padding">
                            <table class="display table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th data-class="expand">
                                            Sequence
                                        </th>
                                        <th data-hide="phone,tablet">
                                            Approval Step
                                        </th>
                                        <th data-hide="phone,tablet">
                                            Approvers
                                        </th>
                                        <th data-hide="phone,tablet">
                                            Amount
                                        </th>
                                        <th data-hide="phone,tablet">
                                            Actions
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (WorkflowDetailDTO item in Model.Details)
                                    {
                                        string strDisabled = "";
                                        string btnGroupAction = string.Empty;
                                        btnGroupAction = "<a href='/Workflow/Approver/?id=" + item.HeaderID + "&seq=" + item.State + "&role=" + item.RoleID + "' class='glyphicon glyphicon-user btn btn-default btn-xs' rel='tooltip' data-placement='top' data-original-title='Approver'></a>&nbsp;";

                                        btnGroupAction += "<button type='button' class='glyphicon glyphicon-pencil btn btn-success btn-xs' data-toggle='modal' data-target='#ModalCreateNew' onclick='EditModal(\"" + item.State + "\", \"" + item.Name + "\", \"" + item.RoleID + "\", \"" + item.AmountID + "\");' rel='tooltip' data-placement='top' data-original-title='Edit Data' " + strDisabled + "></button>&nbsp;" +
                                        "<button type='button' class='glyphicon glyphicon-trash btn btn-danger btn-xs' data-toggle='modal' data-target='#ModalDelete' onclick='DeleteMapping(\"" + item.HeaderID + "\", \"" + item.State + "\", \"" + item.Name + "\");' rel='tooltip' data-placement='top' data-original-title='Delete Data' " + strDisabled + "></button>&nbsp;";

                                        <tr>
                                            <td>@item.State</td>
                                            <td>@item.Name</td>
                                            <td>@item.Approver</td>
                                            <td>@item.AmountDesc</td>
                                            <td>@Html.Raw(btnGroupAction)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="container-fluid">
                                @* Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                @Html.PagedListPager(Model, page => Url.Action("Index", new { page })) *@
                            </div>
                        </div>
                        <!--END WIDGET BODY-->
                    </div>
                    <!--END WIDGET DIV-->
                </div>
            </article>
        </div>
        <!--END User Mapping-->
    </section>
</div>

@{
    await Html.RenderPartialAsync("_WorkflowDetailModal"); /* Request.IsAuthenticated */
}

<script>
    function CreateNewModal() {
        $('#ApprovalState').val($('#NextSequence').val());
        $('#ApprovalStep').val('');
        $('#RoleAccesId').val('');
        //$('#MainContent_ApprovalRole').change();
        $('#AmountId').val('');
        //$('#MainContent_Amount').change();
    }
</script>