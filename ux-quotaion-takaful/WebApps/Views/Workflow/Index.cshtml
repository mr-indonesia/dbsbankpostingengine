@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model X.PagedList.IPagedList<Apps.Core.DTOS.WorkflowDTO>

<div id="content">
    <h1 class="page-title txt-color-blueDark">
        <i class="fa-fw fa fa-desktop"></i>
        Workflow Config
    </h1>

    <!--WIDGET GRID-->
    <section id="widget-grid">
        <!--User Mapping-->
        <div class="row">
            <article class="col-sm-12">
                <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-0" data-widget-togglebutton="false" data-widget-editbutton="false" data-widget-fullscreenbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false">
                    <!--HEADER WIDGET-->
                    <header>
                        <span class="widget-icon"><i class="fa fa-table txt-color-blueDark"></i></span>
                        <h2>Workflow > Setup</h2>
                    </header>
                    <!--END HEADER WIDGET-->
                    <!--WIDGET DIV-->
                    <div>
                        <!--Workflow Button-->
                        <div class="row">
                            <div class="col-sm-9"></div>
                            <div class="col-sm-3">
                                <div class="input-group">
                                    <span class="input-group-addon"><i class="glyphicon glyphicon-search"></i></span>
                                    <input type="search" id="customSearch" class="form-control" onkeyup="FilterTable();">
                                </div>
                            </div>
                            <div class="col-sm-2">
                                <p>
                                    <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#ModalCreateWorkflow">NEW WORKFLOW</button>
                                </p>
                            </div>
                        </div>
                        <!--End Workflow Button-->
                        <br />
                        <!--EDIT BOX-->
                        <div class="jarviswidget-editbox">
                        </div>
                        <!--END EDIT BOX-->
                        <!--WIDGET BODY-->
                        <div class="widget-body no-padding">
                            <table class="display table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th data-class="expand">
                                            @Html.DisplayNameFor(model => model[0].HeaderID)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].Name)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].CategoryTypeID)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].Status)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].ModifiedBy)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].ModifiedDate)
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {

                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.HeaderID)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Name)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CategoryTypeID)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Status)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ModifiedBy)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ModifiedDate)
                                            </td>
                                            <td width="100px">
                                                <form id="@item.HeaderID.Replace('.','_')" method="POST" action="/Workflow/Delete/?id=@item.HeaderID">
                                                    @Html.AntiForgeryToken()
                                                    <button class="glyphicon glyphicon-eye-open btn btn-primary btn-xs" rel="tooltip" data-placement="top" data-original-title="View Data" disabled></button>
                                                    <a href="/Workflow/Detail/?id=@item.HeaderID" class="glyphicon glyphicon-pencil btn btn-success btn-xs" rel="tooltip" data-placement="top" data-original-title="Edit Data"></a>
                                                    <a href="#" class="glyphicon glyphicon-trash btn btn-danger btn-xs" rel="tooltip" data-placement="top" data-original-title="Delete Data" data-toggle="modal" data-target="#confirm-delete" onclick="confirmDelete('@item.HeaderID.Replace('.','_')')"></a>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="container-fluid">
                                Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                @Html.PagedListPager(Model, page => Url.Action("Index", new { page }))
                            </div>
                        </div>
                        <!--END WIDGET BODY-->
                    </div>
                    <!--END WIDGET DIV-->
                </div>
            </article>
        </div>
        <!--END User Mapping-->
    </section>
</div>

@{
    await Html.RenderPartialAsync("_WorkFlowModal"); /* Request.IsAuthenticated */
}