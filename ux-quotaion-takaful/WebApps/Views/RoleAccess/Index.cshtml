@using X.PagedList.Mvc.Core;
@using X.PagedList;
@model X.PagedList.IPagedList<Apps.Core.Models.RoleAccess.RoleAccessViewModel>

<div id="content">
    <h1 class="page-title txt-color-blueDark">
        <i class="fa-fw fa fa-desktop"></i>
        Role Access
    </h1>

    <!--WIDGET GRID-->
    <section id="widget-grid">
        <!--User Info-->
        <div class="row">
            <article class="col-sm-12">
                <div class="jarviswidget jarviswidget-color-blueDark" id="wid-id-0" data-widget-togglebutton="false" data-widget-editbutton="false" data-widget-fullscreenbutton="false" data-widget-colorbutton="false" data-widget-deletebutton="false">
                    <!--HEADER WIDGET-->
                    <header>
                        <span class="widget-icon"><i class="fa fa-table txt-color-blueDark"></i></span>
                        <h2>Role Access</h2>
                    </header>
                    <!--END HEADER WIDGET-->
                    <!--WIDGET DIV-->
                    <div>
                        <!--EDIT BOX-->
                        <div class="jarviswidget-editbox">
                        </div>
                        <!--END EDIT BOX-->
                        <!--WIDGET BODY-->
                        <div class="widget-body">
                            <table id="table_record" class="datatable table table-striped table-bordered">
                                <caption>
                                    <div class="row">
                                        <div class="col-sm-8">
                                            <p>
                                                @* <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#ModalRoleAccess" onclick="addRoleAccess()">Create Role Access</button> *@
                                                <a href="javascript:void(0);" onclick="addRoleAccess()" class="btn btn-primary">Create Role Access</a>
                                            </p>
                                        </div>
                                        <div class="col-sm-4">
                                            @using (Html.BeginForm("Index", "RoleAccess", FormMethod.Get))
                                            {
                                                <div class="input-group">
                                                    <input class="form-control" id="searchvalue" name="Search" type="text" placeholder="Search..." value="@ViewBag.Search">
                                                    <div class="input-group-btn">
                                                        <button class="btn btn-default" type="submit">
                                                            <i class="fa fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </caption>
                                <thead>
                                    <tr>
                                        <th data-class="expand">
                                            @Html.DisplayNameFor(model => model[0].RoleAccessID)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].RoleAccessName)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].CreatedAt)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].CreatedBy)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].ModifiedAt)
                                        </th>
                                        <th data-hide="phone,tablet">
                                            @Html.DisplayNameFor(model => model[0].ModifiedBy)
                                        </th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RoleAccessID)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.RoleAccessName)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedAt)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.CreatedBy)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ModifiedAt)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.ModifiedBy)
                                            </td>
                                            <td width="100px">
                                                <form id="@item.RoleAccessID.Replace('.','_')" method="POST" action="/RoleAccess/Delete/?id=@item.RoleAccessID">
                                                    @Html.AntiForgeryToken()
                                                    @* <a href="/RoleAccess/Edit/?id=@item.RoleAccessID" class="glyphicon glyphicon-pencil btn btn-success btn-xs" rel="tooltip" data-placement="top" data-original-title="Edit Data"></a> *@
                                                    <a href="javascript:void(0);" onclick="editRoleAccess('@item.RoleAccessID')" class="glyphicon glyphicon-pencil btn btn-success btn-xs" rel="tooltip" data-placement="top" data-original-title="Edit Data"></a>
                                                    @* <button onclick="editRoleAccess(@item.RoleAccessID)" class="glyphicon glyphicon-pencil btn btn-success btn-xs" rel="tooltip" data-placement="top" data-original-title="Edit Data"></button> *@
                                                    <a href="#" class="glyphicon glyphicon-trash btn btn-danger btn-xs" rel="tooltip" data-placement="top" data-original-title="Delete Data" data-toggle="modal" data-target="#confirm-delete" onclick="confirmDelete('@item.RoleAccessID.Replace('.','_')')"></a>
                                                </form>
                                            </td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                            <div class="container-fluid">
                                Page @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) of @Model.PageCount
                                @Html.PagedListPager(Model, page => Url.Action("Index", new { page, ViewBag.Search }))
                            </div>
                        </div>
                        <!--END WIDGET BODY-->
                    </div>
                    <!--END WIDGET DIV-->
                </div>
            </article>
        </div>
        <!--END User Info-->
    </section>
</div>


<!-- Add Role Access -->
<div class="modal fade" id="ModalRoleAccess" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    ×
                </button>
                <h4 class="modal-title" id="modalTitle">Add Role Access</h4>
            </div>
            <div class="modal-body">
                <form id="roleAccessForm" method="POST" action="">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="Id" name="Id" value="0">
                    <fieldset>
                        <!-- Modal Content -->
                        <div class="form-horizontal">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Role Access Code</label>
                                    <div class="col-md-8">
                                        <input type="text" id="RoleAccessId" name="RoleAccessId" class="form-control" required="required">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Role Access Name</label>
                                    <div class="col-md-8">
                                        <input type="text" id="RoleAccessName" name="RoleAccessName" class="form-control" required="required">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <div class="modal-footer">
                        <button type="reset" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                        <button type="submit" name="submit" class="btn btn-primary">
                            save
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
<!-- End Add Role Access -->
