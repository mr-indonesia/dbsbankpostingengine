@{
    var route = AppsHttpContext.Current.Request.RouteValues["controller"].ToString().ToUpper();
    switch (route)
    {
        case "COMPANY":
            ViewBag.formUrl = "/Company/ApproveCompanyAgent";
            // ViewBag.excludeType = "CPR";
            // ViewBag.excludeRefId = @Model.ProjReqId;
            // ViewBag.ProjId = @Model.ProjId;
            break;
        default:
            ViewBag.formUrl = "/";
            break;
    }
}

<!-- Modal Delete Confirm-->
<div class="modal fade" id="ModalApproveCompany" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="ApproveTitle">Approve Confirm</h4>
            </div>
            <div class="modal-body">
                <form id="approveCompanyForm" method="POST" action="@ViewBag.formUrl" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="coCode" name="coCode" value="0">
                    <fieldset>
                        <p>Are you sure want to approve this ?</p>
                    </fieldset>
                    @* <fieldset class="form-horizontal">
                        <div class="form-group">
                            <div class="col-md-12">
                                <textarea rows="4" id="approveremark" name="approveremark" class="form-control" onblur=""></textarea>
                                <span class="emsg"></span>
                            </div>
                        </div>
                    </fieldset> *@
                    <footer class="modal-footer">
                        <div id="approveItemMsg" class="alert alert-block alert-danger" style="display:none; text-align: left;"></div>
                        <button type="reset" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                        <button type="submit" name="submit" class="btn btn-primary">Approve</button>
                    </footer>
                </form>                
            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div>
<!-- /.modal -->