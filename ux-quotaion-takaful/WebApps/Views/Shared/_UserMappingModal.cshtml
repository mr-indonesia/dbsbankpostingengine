@{
  
    ViewBag.formUrl = "/UserMapping/AddUserMapping";
}

<!-- Add WorkFlow -->
<div class="modal fade" id="ModalCreateUserMapping" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    ×
                </button>
                <h4 class="modal-title" id="myModalLabel">Add User Mapping</h4>
            </div>
            <div class="modal-body">
                <form method="POST" action="@ViewBag.formUrl" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <fieldset>
                        <!-- Modal Content -->
                        <div class="form-horizontal">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Workflow Name</label>
                                    <div class="col-md-8">
                                        <input type="text" id="WorkflowName" name="WorkflowName" class="form-control" required="required">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Role Access</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("roleAccessList", ViewBag.roleAccessList as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "form-control selectpicker", @data_live_search = "true", @required = "required" })
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Map User</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ddlUserList", ViewBag.ddlUserList as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "select2", @required = "required", @multiple = "multiple" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <div class="modal-footer">
                        <div id="addItemMsg" class="alert alert-block alert-danger" style="display:none;"></div>
                        <button type="reset" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                        <button type="submit" name="submit" class="btn btn-primary">
                            save
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
<!-- End Add WorkFlow -->