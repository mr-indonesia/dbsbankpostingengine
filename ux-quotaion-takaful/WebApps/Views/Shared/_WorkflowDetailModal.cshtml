<!-- Detail Approval Workflow-->
<div class="modal fade" id="ModalAddWorkflowApproval" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    ×
                </button>
                <h4 class="modal-title" id="myModalLabel">Add Step</h4>
            </div>
            <div class="modal-body">
                <fieldset>
                    <!-- Modal Content -->
                    <div class="form-horizontal">
                        <div style="text-align: center; padding: 10px; border: 1px solid grey; background-color: #d3d3d321; font-weight: bold;">
                            <b>Approval Step</b>
                        </div>
                        <div class="col-md-6 col-sm-6 col-md-push-3">
                            <br />
                            <div class="form-group">
                                <label class="col-md-4 control-label italicbold">Approval Step</label>
                                <div class="col-md-8">
                                    <input type="text" id="NextSequence" name="NextSequence" value="@ViewBag.nextSeq" class="form-control hidden" />
                                    <input type="text" id="ApprovalState" name="ApprovalState" value="" class="form-control hidden" />
                                    <input type="text" id="ApprovalStep" name="ApprovalStep" value="" class="form-control" />
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="RoleAccesId" class="col-md-4 control-label italicbold">Approval Role</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("RoleAccesId", ViewBag.RoleAccessList as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "form-control selectpicker", @data_live_search = "true" })
                                </div>
                            </div>
                            <div class="form-group">
                                <label for="AmountId" class="col-md-4 control-label italicbold">Amount</label>
                                <div class="col-md-8">
                                    @Html.DropDownList("AmountId", ViewBag.WfAmountList as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "form-control selectpicker", @data_live_search = "true" })
                                </div>
                            </div>
                        </div>
                    </div>
                </fieldset>
            </div>
            <div class="modal-footer">
                <div id="addItemMsg" class="alert alert-block alert-danger" style="display:none;"></div>
                <button type="reset" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                <button type="submit" name="submit" class="btn btn-primary">
                    save
                </button>
            </div>
        </div>
    </div>
</div>
<!-- End Detail Approval Workflow-->