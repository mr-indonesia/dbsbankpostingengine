@{
    var route = AppsHttpContext.Current.Request.RouteValues["controller"].ToString().ToUpper();
    switch (route)
    {
        case "WORKFLOW":
            ViewBag.formUrl = "/Workflow/AddWorkflow";
            // ViewBag.excludeType = "CPR";
            // ViewBag.excludeRefId = @Model.ProjReqId;
            // ViewBag.ProjId = @Model.ProjId;
            break;
        default:
            ViewBag.formUrl = "/";
            break;
    }
}

<!-- Add WorkFlow -->
<div class="modal fade" id="ModalCreateWorkflow" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    ×
                </button>
                <h4 class="modal-title" id="myModalLabel">Add Workflow</h4>
            </div>
            <div class="modal-body">
                <form method="POST" action="@ViewBag.formUrl" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <fieldset>
                        <!-- Modal Content -->
                        <div class="form-horizontal">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Workflow Name</label>
                                    <div class="col-md-8">
                                        <input type="text" id="WorkflowName" name="WorkflowName" class="form-control" required="required">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-md-3 control-label italicbold">Group Product</label>
                                    <div class="col-md-8">
                                        @Html.DropDownList("ProductGroups", ViewBag.ProductGroups as IEnumerable<SelectListItem>, htmlAttributes: new { @class = "form-control selectpicker", @data_live_search = "true" })
                                    </div>
                                </div>
                            </div>
                        </div>
                    </fieldset>
                    <div class="modal-footer">
                        <div id="addItemMsg" class="alert alert-block alert-danger" style="display:none;"></div>
                        <button type="reset" class="btn btn-danger" data-dismiss="modal">Cancel</button>
                        <button type="submit" name="submit" class="btn btn-primary">
                            save
                        </button>
                    </div>
                </form>                
            </div>
            
        </div>
    </div>
</div>
<!-- End Add WorkFlow -->